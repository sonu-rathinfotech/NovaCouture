    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "pg": "^8.16.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "sharp": "^0.35.3"
