    "db:upload-samples": "node tools/upload-samples.mjs",
    "db:blur-previews": "node tools/generate-blur-previews.mjs",
    "validate:import": "node tools/validate-import.mjs",
    "admin:grant": "node tools/grant-admin.mjs",
