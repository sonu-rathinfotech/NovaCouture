# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Enquiry (scope §D) ---
# Pending: the client has not supplied the Nova Couture enquiry address yet.
VITE_ENQUIRY_EMAIL=

# --- Feature flags (PLAN.md §6) ---
# Show the enquiry button to registered non-premium users. Client decision pending.
VITE_FEATURE_ENQUIRY_FOR_REGISTERED=false
# Live WhatsApp OTP login. Keep false until the Business API and an approved
# OTP template are available; interim credential login is used until then.
VITE_FEATURE_OTP_LOGIN=false

# Record which pieces a client opens from inside a curated link (scope §G,
# "optional"). Off by default: it tracks a named client's browsing, so it needs
# a deliberate decision and a matching line in the Privacy Policy.
VITE_FEATURE_COLLECTION_PRODUCT_VIEWS=false
